{
  "name": "mongo-learning",
  "version": "1.0.0",
  "description": "โปรเจคฝึก MongoDB ด้วย Node.js ทีละบท",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:shell": "docker exec -it mongo-learning mongosh bookstore",
    "seed": "node seed/seed.js",
    "l1": "node lessons/01-connect.js",
