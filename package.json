    "l3": "node lessons/03-find.js",
    "l4": "node lessons/04-update.js",
    "l5": "node lessons/05-delete.js",
    "l6": "node lessons/06-indexes.js",
    "l7": "node lessons/07-aggregation.js",
    "l8": "node lessons/08-relationships.js",
    "l9": "node lessons/09-transactions.js",
    "l10": "node lessons/10-mongoose.js",
    "ex": "node exercises/exercises.js",
    "ex:solutions": "node exercises/solutions/solutions.js"
